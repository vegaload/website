---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | VegaLoad" description="This page does not exist." path="/404/" noindex>
  <div class="wrap">
    <section class="page-head" style="padding-bottom: 120px">
      <p class="kicker">404</p>
      <h1>Page not found</h1>
      <p>This page does not exist.</p>
      <p style="margin-top: 22px">
        <a class="pill pill-solid" href="/">Go to the home page</a>
        &nbsp;
        <a class="pill pill-ghost" href="/blog/">Read the blog</a>
      </p>
    </section>
  </div>
</BaseLayout>
