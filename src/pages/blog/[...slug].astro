---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, formatDate, readingMinutes, tagSlug } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, author, tags, draft } = post.data;
const path = `/blog/${post.id}/`;

const people =
  author === 'The VegaLoad team'
    ? []
    : author
        .split(/,|\sand\s/)
        .map((name) => name.trim())
        .filter(Boolean)
        .map((name) => ({ '@type': 'Person', name }));

const authorLd =
  author === 'The VegaLoad team'
    ? { '@type': 'Organization', name: author }
    : people.length === 1
      ? people[0]
      : people;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: authorLd,
  publisher: { '@type': 'Organization', name: 'VegaLoad', url: 'https://vegaload.ai/' },
  mainEntityOfPage: new URL(path, 'https://vegaload.ai').toString(),
};
---

<BaseLayout
  title={`${title} | VegaLoad blog`}
  description={description}
  path={path}
  type="article"
  publishedTime={date}
  modifiedTime={updated}
  jsonLd={jsonLd}
  active="blog"
>
  <article class="wrap">
    <header class="post-head">
      {draft && <span class="draft-flag">Draft: only visible in dev</span>}
      <p class="kicker">Blog</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <p class="post-meta">
        {author} · {formatDate(date)} · {readingMinutes(post.body)} min read
        {updated && ` · Updated ${formatDate(updated)}`}
      </p>
      {
        tags.length > 0 && (
          <div class="post-tags">
            {tags.map((t) => (
              <a class="tag" href={`/blog/tags/${tagSlug(t)}/`}>
                {t}
              </a>
            ))}
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      <a class="back" href="/blog/">← All posts</a>
      <a class="pill pill-ghost" href="https://github.com/vegaload/vegaload">View VegaLoad on GitHub</a>
    </footer>
  </article>
</BaseLayout>
