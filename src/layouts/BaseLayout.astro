---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string; // for example "/blog/"
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  active?: 'blog' | '';
}

const {
  title,
  description,
  path,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
  active = '',
} = Astro.props;

const siteUrl = 'https://vegaload.ai';
const canonical = new URL(path, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070707" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="VegaLoad blog" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="VegaLoad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="VegaLoad home">
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path d="M8 17 L24 43 L40 17" fill="none" stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="24" cy="7" r="5" fill="#00ADE4" />
          </svg>
          <span>VegaLoad</span>
        </a>
        <nav class="navlinks" aria-label="Site">
          <a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="https://vegaload.github.io/vegaload/">Docs</a>
        </nav>
        <div class="nav-actions">
          <a class="pill pill-ghost hide-sm" href="https://github.com/vegaload/vegaload">GitHub</a>
          <a class="pill pill-solid" href="/#install">Install</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p>
          Open source, sponsored by <a href="https://www.harness.io">Harness</a>.
        </p>
        <ul>
          <li><a href="https://github.com/vegaload/vegaload">GitHub</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="https://vegaload.github.io/vegaload/">Docs</a></li>
          <li><a href="/rss.xml">RSS</a></li>
          <li><a href="https://github.com/vegaload/vegaload/blob/main/LICENSE">Apache-2.0 License</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
