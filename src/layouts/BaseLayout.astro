---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string; // for example "/blog/"
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>;
  active?: 'blog' | '';
  image?: string;
}

const {
  title,
  description,
  path,
  type = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  jsonLd,
  active = '',
  image,
} = Astro.props;

const siteUrl = 'https://vegaload.ai';
const canonical = new URL(path, siteUrl).toString();
const imagePath = image ? (image.startsWith('/') ? image : `/${image}`) : '/og-default.png';
const imageUrl = new URL(imagePath, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#070707" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="VegaLoad blog" href="/rss.xml" />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="VegaLoad" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="VegaLoad, load testing for agentic developers." />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/" aria-label="VegaLoad home">
          <svg viewBox="0 0 48 48" aria-hidden="true">
            <path d="M8 17 L24 43 L40 17" fill="none" stroke="#FFFFFF" stroke-width="5.5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="24" cy="7" r="5" fill="#00ADE4" />
          </svg>
          <span>VegaLoad</span>
        </a>
        <nav class="navlinks" id="site-nav" aria-label="Page sections">
          <a href="/#workflow">The Shift</a>
          <a href="/?slide=1#workflow">Co-located</a>
          <a href="/#platform">Features</a>
          <a href="/?slide=1#platform">Safety</a>
          <a href="/?slide=3#platform">Migrate</a>
          <a href="/blog/" aria-current={active === 'blog' ? 'page' : undefined}>Blog</a>
          <a href="https://vegaload.github.io/vegaload/">Docs</a>
        </nav>
        <div class="nav-actions">
          <button class="nav-menu" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
          <a class="gh-star" href="https://github.com/vegaload/vegaload" target="_blank" rel="noopener noreferrer" aria-label="Star VegaLoad on GitHub"><span class="gh-star-main"><svg viewBox="0 0 16 16" width="13" height="13" aria-hidden="true"><path fill="currentColor" d="M8 1.15l1.74 3.52 3.89.57-2.81 2.74.66 3.87L8 10l-3.48 1.85.66-3.87L2.37 5.24l3.89-.57L8 1.15z"/></svg>Star</span><span class="gh-star-count" data-github-stars hidden></span></a>
          <a class="pill pill-solid pill-sm" href="/#install">Install</a>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <div class="wrap foot">
        <div>
          <p class="sponsor-kicker">Sponsored by</p>
          <a class="sponsor-logo" href="https://www.harness.io" aria-label="Harness">
            <img src="/harness-logo.png" alt="Harness" />
          </a>
          <p class="sponsor-text">VegaLoad is an open-source project sponsored by Harness.</p>
        </div>
        <div>
          <div class="foot-links">
            <ul>
              <li><a href="https://github.com/vegaload/vegaload">GitHub</a></li>
              <li><a href="https://vegaload.github.io/vegaload/">Docs</a></li>
              <li><a href="https://github.com/vegaload/vegaload/tree/main/examples/cookbook">Cookbook</a></li>
            </ul>
            <ul>
              <li><a href="https://www.harness.io/products/resilience-testing">Harness Resilience Testing</a></li>
            </ul>
          </div>
        </div>
        <div class="legal">
          <p><strong>© 2026 Harness, Inc.</strong> All copyrights for VegaLoad belong to Harness.</p>
          <p>VegaLoad is released under the Apache License 2.0. Harness and the Harness logo are trademarks of Harness, Inc.</p>
        </div>
      </div>
    </footer>
    <script>
      const header = document.querySelector('.nav');
      const button = document.querySelector('.nav-menu');
      const links = document.querySelector('.navlinks');
      if (header && button && links) {
        button.addEventListener('click', () => {
          const open = header.classList.toggle('is-open');
          button.setAttribute('aria-expanded', open ? 'true' : 'false');
          button.textContent = open ? 'Close' : 'Menu';
        });
        links.addEventListener('click', (event) => {
          if (!(event.target instanceof Element) || !event.target.closest('a')) return;
          header.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
          button.textContent = 'Menu';
        });
      }
      fetch('https://api.github.com/repos/vegaload/vegaload')
        .then((response) => (response.ok ? response.json() : null))
        .then((data) => {
          if (!data || typeof data.stargazers_count !== 'number') return;
          const n = data.stargazers_count;
          const text = n > 999 ? (n / 1000).toFixed(1) + 'k' : String(n);
          document.querySelectorAll('[data-github-stars]').forEach((el) => {
            el.textContent = text;
            if (el instanceof HTMLElement) el.hidden = false;
            const link = el.closest('a');
            if (link) link.setAttribute('aria-label', 'Star VegaLoad on GitHub, ' + n + (n === 1 ? ' star' : ' stars'));
          });
        })
        .catch(() => {});
    </script>
  </body>
</html>
